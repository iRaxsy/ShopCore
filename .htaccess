# ShopCore web koku korumasi
# Not: T16 tamamlandi - Bootstrap/SweetAlert2/Quicksand artik content/vendor/
# altindan yerel yukleniyor, jQuery kaldirildi. Bu yuzden CSP'de tek harici
# origin kaldi: CKEditor (yalnizca 4 form sayfasi). O da yerellestirilirse
# script-src/connect-src tamamen 'self' olur.

Options -Indexes -ExecCGI -MultiViews
ServerSignature Off

# Guvenlik basliklari
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    Header always set X-XSS-Protection "0"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://cdn.ckeditor.com; font-src 'self' data:; connect-src 'self' https://cdn.ckeditor.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# Dokuman/yedek uzantilari HTTP ile indirilemesin
<FilesMatch "\.(sql|md|log|ini|bak)$">
    Require all denied
</FilesMatch>

# --- Sikistirma (mod_deflate + mod_filter) ---
# Statik varliklar yerellestigi icin (T16) en agir dosya artik Bootstrap CSS
# (233 KB). DEFLATE olmadan bu hacim ham olarak tasinir. Text/JS/CSS/SVG/JSON
# tipleri sikistirilir; JPEG/PNG/WebP/woff2 zaten sikistirilmis bicimlerde
# saklandigi icin ikinci katman bosuna CPU harcamak olurdu - listeye
# bilincli alinmadi.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE \
            text/html text/plain text/xml \
            text/css text/javascript application/javascript application/json \
            image/svg+xml application/x-font-ttf font/opentype
    </IfModule>
</IfModule>

# --- Onbellekleme (mod_expires) ---
# Parmak izli (?v=<filemtime>, T17) adresler icerik degisince kendiliginden
# degistigi icin uzun onbellek guvencesidir. Logo/default.png ve yazi tipi
# dosyalari gibi SABIT adli varliklar da bu kurala girer: o dosyalari
# degistirmek icin yeniden adlandirip referansi guncellemek gerekir.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType text/javascript         "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType application/font-woff2  "access plus 1 year"
</IfModule>

# Cache-Control: parmak izli statiklerde immutable (tarayici icerigi
# yeniden dogrulama ihtiyaci duymaz); HTML/PHP cikisi ise no-store - sepet
# ve oturum durumu her sayfada sunucuda yeniden belirleniyor; proxy veya
# ortak onbellege dusmemeli.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html?)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
