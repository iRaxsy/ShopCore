<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS karsiligi: config/.htaccess ("Require all denied").

  Amac: veritabani kimlik bilgilerini iceren config/yerel.php, Apache disi
  sunucuda (IIS) HTTP ile indirilemesin. PHP bu klasoru DISKTEN okur
  (includes/bootstrap.php icindeki require) - HTTP erisimine ihtiyaci yok,
  bu yuzden klasorun tam kapali olmasi davranisi bozmaz.

  Yontem: requestFiltering / fileExtensions allowUnlisted="false" + bos liste
  = uzantili HER dosya 403/404 ile reddedilir ("Require all denied" karsiligi).
  requestFiltering bolumu applicationHost.config'de overrideModeDefault="Allow"
  oldugu icin alt klasorde serbestce kullanilabilir; ipSecurity varsayilan
  olarak "Deny" oldugundan 500.19 hatasi verirdi, URL Rewrite modulu ise
  kurulu olmayabilir.

  Apache tarafinda bu dosya yok sayilir; .htaccess zaten ayni isi yapar.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <directoryBrowse enabled="false" />
        <fileExtensions allowUnlisted="false">
          <clear />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
