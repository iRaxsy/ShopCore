<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS karsiligi: content/images/.htaccess (php_flag engine off + RemoveHandler
  .php .phtml .php3-8 + FilesMatch Require all denied).

  Amac: yuklenen gorsellerin klasorune sizar olasi bir betik dosyasi IIS'de
  ASLA calistirilmasin - PHP2Shell savunmasinin son kalesi.

  Yontem: requestFiltering / fileExtensions. IIS'de URL Rewrite modulu yerine
  yerlesik istek filtreleme kullanilir: "security/requestFiltering" bolumu
  applicationHost.config'de overrideModeDefault="Allow" oldugu icin alt
  klasorde web.config ile genisletilebilir; ipSecurity (Deny) ya da eksik URL
  Rewrite modulu (tanimsiz bolum) ise siteyi 500.19 ile dusururdu.
  allowUnlisted="true" birakilir: gorseller sunulmaya devam eder, yalnizca
  asagidaki betik uzantilari 404 ile kesilir.

  Apache tarafinda bu dosya yok sayilir; .htaccess zaten ayni isi yapar.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".php" allowed="false" />
          <add fileExtension=".php3" allowed="false" />
          <add fileExtension=".php4" allowed="false" />
          <add fileExtension=".php5" allowed="false" />
          <add fileExtension=".php7" allowed="false" />
          <add fileExtension=".php8" allowed="false" />
          <add fileExtension=".php9" allowed="false" />
          <add fileExtension=".phtml" allowed="false" />
          <add fileExtension=".phar" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
