<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS karsiligi: includes/.htaccess ("Require all denied").

  Amac: includes/ altindaki dahili dosyalar (db.php, csrf.php, yetki.php ...)
  HTTP ile dogrudan cagrildiginda PHP kodlari sunucuda calisip beklenmedik
  ciktilar uretmesin / sinif yapisini ifsa etmesin. Bu dosyalar yalnizca
  bootstrap.php uzerinden diskten include edilir, HTTP'ye ihtiyaci yoktur.

  Yontem: requestFiltering / fileExtensions allowUnlisted="false" + bos liste
  = uzantili HER dosya reddedilir ("Require all denied" karsiligi).
  requestFiltering bolumu applicationHost.config'de overrideModeDefault="Allow"
  oldugu icin alt klasorde serbestce kullanilabilir; ipSecurity varsayilan
  olarak "Deny" oldugundan 500.19 hatasi verirdi, URL Rewrite modulu ise
  kurulu olmayabilir.

  Apache tarafinda bu dosya yok sayilir; .htaccess zaten ayni isi yapar.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <directoryBrowse enabled="false" />
        <fileExtensions allowUnlisted="false">
          <clear />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
