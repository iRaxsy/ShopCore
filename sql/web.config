<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS karsiligi: sql/.htaccess ("Require all denied").

  Amac: sql/ altindaki sem ve ornek veri dosyalari (shopcore.sql,
  ornek-veri.sql) IIS'de HTTP ile indirilemesin - sema indirilen bir sitede
  tablo/kolon ve varsayilan yonetici bilgileri ifsa olmus olur. Kurulumda PHP
  bu dosyalari diskten okur, HTTP erisimine gerek yoktur.

  Yontem: requestFiltering / fileExtensions allowUnlisted="false" + bos liste
  = uzantili HER dosya reddedilir ("Require all denied" karsiligi).
  requestFiltering bolumu applicationHost.config'de overrideModeDefault="Allow"
  oldugu icin alt klasorde serbestce kullanilabilir; ipSecurity varsayilan
  olarak "Deny" oldugundan 500.19 hatasi verirdi, URL Rewrite modulu ise
  kurulu olmayabilir.

  Apache tarafinda bu dosya yok sayilir; .htaccess zaten ayni isi yapar.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <directoryBrowse enabled="false" />
        <fileExtensions allowUnlisted="false">
          <clear />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
