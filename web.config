<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS karsiligi: .htaccess (proje koku). Apache disindaki sunucularda .htaccess
  hic islemez; IIS bu dosyayi okur. Bu web.config, kok .htaccess'teki "HTTP ile
  indirilemesin" listesini birebir tekrarlar (bkz. .htaccess L21-23:
  \.(sql|md|log|ini|bak)$ -> Require all denied).

  Yontem: requestFiltering / fileExtensions. "security/requestFiltering" bolumu
  applicationHost.config'de overrideModeDefault="Allow" oldugu icin site
  altindaki web.config dosyalariyla genisletilebilir (ipSecurity "Deny" oldugu
  icin 500.19 verirdi; URL Rewrite modulu ise kurulu olmayabilir).

  allowUnlisted="true" sarti: PHP buradan calismaya devam etmeli (index.php,
  giris.php, admin/* ...). Yalnizca veri/dokuman uzantilari reddedilir; bu
  yuzden listeye .php EKLENMEZ.

  Apache tarafinda bu dosya yok sayilir; .htaccess zaten ayni isi yapar.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- IIS varsayilan reddettigi uzantilar (.asp vb.) korunur, listeye
             ekleme yapilir (clear cagrilmaz). -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Guvenlik basliklari + Cache-Control: .htaccess L12-17 ve L70-72'nin
         IIS karsiligi. customHeaders tum yanıtlara uygulanir; statik varliklar
         (content/) asagidaki <location> ile no-store'dan muaf tutulur.
         Apache bu dosyayi yok sayar (.htaccess ayni isi yapar). -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="X-XSS-Protection" value="0" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=(), payment=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://cdn.ckeditor.com; font-src 'self' data:; connect-src 'self' https://cdn.ckeditor.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" />
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- content/ altindaki statik varliklar (css/js/gorsel/font) uzun onbellek
         alsin; <clear/> kokten devralinan no-store + basliklari bu alt agac icin
         sifirlar. Icerik-parmak-izi (?v=filemtime) degisince adres degisir. -->
  <location path="content">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <clear />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Cache-Control" value="public, max-age=2592000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
